# These files are loaded post GUI, in the order they appear

#source hallib/pyvcp_options.hal
#source hallib/custom_postgui.hal
net probe-in     =>  motion.probe-input  qtdragon.led-probe

#net tool-change             hal_manualtoolchange.change   <=  iocontrol.0.tool-change
#net tool-changed            hal_manualtoolchange.changed  <=  iocontrol.0.tool-changed
#net tool-prep-number        hal_manualtoolchange.number   <=  iocontrol.0.tool-prep-number

#net pocketprepnumer         iocontrol.0.tool-prep-pocket 


# Tool Information
#net toolnumber  iocontrol.0.tool-number 
#net toolprepnumber iocontrol.0.tool-prep-number  
#net pocketprepnumer iocontrol.0.tool-prep-pocket 


net tool-change         hal_manualtoolchange.change             <=  iocontrol.0.tool-change 
net tool-changed        hal_manualtoolchange.changed            <=  iocontrol.0.tool-changed
net tool-prep-number    hal_manualtoolchange.number             <=  iocontrol.0.tool-prep-number
#net tool-number         hal_manualtoolchange.toolchange-number  <=   iocontrol.0.tool-number
net tool-prep-loopback  iocontrol.0.tool-prepare                <=   iocontrol.0.tool-prepared
net pocketprepnumer     iocontrol.0.tool-prep-pocket 

# --- E500 VFD values into QtDragon HD spindle display (signals from spindle_setup.hal) ---
net vfd-amps          => qtdragon.spindle-amps
net vfd-volts         => qtdragon.spindle-volts
net vfd-fault-code    => qtdragon.spindle-fault
net vfd-modbus-errors => qtdragon.spindle-modbus-errors-u32

# --- "Tool length changed a lot - save it?" dialog (INI [DISPLAY] MESSAGE_PINNAME = lengthconfirm) ---
# opened by mcodes/M191 (halcmd sets length-confirm-ask 1), read by macros/tool_measure.ngc
net length-confirm-ask      qtdragon.lengthconfirm
net length-confirm-waiting  qtdragon.lengthconfirm-waiting   => motion.digital-in-04
net length-confirm-yes      qtdragon.lengthconfirm-response  => motion.digital-in-03

# --- M6 "no tool detected in the spindle - load again?" dialog (INI MESSAGE_PINNAME = emptyspindle) ---
# opened by mcodes/M192 (halcmd sets empty-spindle-ask 1), read by macros/rack_change.ngc
net empty-spindle-ask       qtdragon.emptyspindle
net empty-spindle-waiting   qtdragon.emptyspindle-waiting    => motion.digital-in-06
net empty-spindle-yes       qtdragon.emptyspindle-response   => motion.digital-in-05
