# ColdEnd tab in QtDragon HD (qtvcp/panels/coldend) <-> python/coldend.py
# Sourced from postgui_call_list.hal (panel pins only exist after the GUI is up).
# Panel pins are named qtdragon.coldend.<widget name>.
# MIST / AIR are QtDragon's own MIST / FLOOD buttons on the main screen (= M7 / M8, no nets needed).
# grp_main (link + mist LEDs, mist ml/h, PRIME) is moved into the main-screen PROGRAM box by
# qtdragon_hd_handler.py (init_coldend_main) - its pins keep the qtdragon.coldend. names.

# --- status LEDs
net ce-link-ok      coldend.link-ok     => qtdragon.coldend.led_link
net ce-fw-active                        => qtdragon.coldend.led_fw
net ce-mist-on      coldend.mist-on     => qtdragon.coldend.led_mist
net ce-air-on       coldend.air-on      => qtdragon.coldend.led_air
net ce-fast-on      coldend.fast-on     => qtdragon.coldend.led_prime
net ce-sw-mist                          => qtdragon.coldend.led_sw_mist
net ce-sw-fast                          => qtdragon.coldend.led_sw_fast
net ce-sw-air                           => qtdragon.coldend.led_sw_air
net ce-link-ok                          => qtdragon.coldend.led_main_link
net ce-mist-on                          => qtdragon.coldend.led_main_mist

# --- buttons and check boxes
net ce-scr-prime    qtdragon.coldend.btn_prime            => coldend.scr-fast
net ce-scr-reconn   qtdragon.coldend.btn_reconnect        => coldend.reconnect
net ce-scr-nospit   qtdragon.coldend.chk_spit-not         => coldend.no-spit
net ce-scr-screen   qtdragon.coldend.chk_use_screen       => coldend.use-screen

# --- screen rate values
net ce-scr-mist     qtdragon.coldend.ds_mist-f       => coldend.scr-mist-mlh
net ce-scr-fast     qtdragon.coldend.ds_fast-f       => coldend.scr-fast-mlh
net ce-scr-time     qtdragon.coldend.ds_spit_time-f  => coldend.scr-spit-time

# --- live values
net ce-knob-mist-pct  coldend.knob-mist-pct  => qtdragon.coldend.lbl_knob_mist
net ce-knob-spit-pct  coldend.knob-spit-pct  => qtdragon.coldend.lbl_knob_spit
net ce-mist-mlh       coldend.mist-mlh       => qtdragon.coldend.lbl_mist_flow qtdragon.coldend.lbl_main_flow
net ce-fast-mlh       coldend.fast-mlh       => qtdragon.coldend.lbl_fast_flow
net ce-spit-time-s    coldend.spit-time      => qtdragon.coldend.lbl_spit_time
net ce-spit-left-s    coldend.spit-left-s    => qtdragon.coldend.lbl_spit_left
net ce-errors         coldend.errors         => qtdragon.coldend.lbl_errors
