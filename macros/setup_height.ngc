; Setup mode, first step: from travel height, find the top of the part quickly, then re-touch slowly.
; #1 machine X, #2 machine Y, #3 travel height (machine Z), #4 max descent, #5 fast, #6 slow, #7 XY feed
o<setup_height> sub
o100 if [#5210 NE 0]
    (abort, Setup: clear G92 first)
o100 endif
G21 G90
G10 L2 P0 R0
G53 G0 Z#3
G53 G1 X#1 Y#2 F#7
G38.3 Z[#<_z> - #4] F#5
o110 if [#5070 EQ 0]
    (abort, Setup: no surface found under the height point)
o110 endif
G1 Z[#5063 + 2] F#5
G38.2 Z[#5063 - 1] F#6
#<top> = #5063
#<topm> = [#5063 + #[5203 + 20 * #5220] + #5403]
G1 Z[#<top> + 2] F#5
(LOGAPPEND,/tmp/table_nav_probe.log)
(LOG,H #<top> #<topm>)
(LOGCLOSE)
o<setup_height> endsub
M2
