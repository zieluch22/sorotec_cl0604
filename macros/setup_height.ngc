; Setup mode, first step: from travel height, find the top of the part quickly, then re-touch slowly.
; #1 machine X, #2 machine Y, #3 travel height (machine Z), #4 lowest Z to search (machine), #5 fast, #6 slow, #7 XY feed
; #8 digital output that selects the probe input (-1 = none); on_abort.ngc releases it
o<setup_height> sub
o100 if [#5210 NE 0]
    (abort, Setup: clear G92 first)
o100 endif
G21 G90
G10 L2 P0 R0
G53 G0 Z#3
o120 if [#8 GE 0]
    M64 P#8
o120 endif
G53 G1 X#1 Y#2 F#7
; #4 is machine Z: subtract the active offset and the tool length offset (G92 is refused above)
G38.3 Z[#4 - #[5203 + 20 * #5220] - #5403] F#5
o110 if [#5070 EQ 0]
    (abort, Setup: no surface found under the height point)
o110 endif
G1 Z[#5063 + 2] F#5
G38.2 Z[#5063 - 1] F#6
#<top> = #5063
#<topm> = [#5063 + #[5203 + 20 * #5220] + #5403]
G1 Z[#<top> + 2] F#5
(LOGAPPEND,/tmp/table_nav_probe.log)
(LOG,H #<top> #<topm>)
(LOGCLOSE)
o<setup_height> endsub
M2
