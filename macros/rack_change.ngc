; M6 REMAP for the rack tool changer
;
; - Pocket = P column of the tool table (tool number != pocket number).
;   P1..NUMPOCKETS = rack, anything else = manual change position.
; - Old tool's pocket comes from the tool table (#<old_home>, set in change_prolog),
;   so it survives restarts and M61. -1 = not found -> manual removal (safe).
; - New tool's pocket from iocontrol.0.tool-prep-pocket via M66 E0, cross-checked
;   against the tool table (#<new_home>).
; - Rack moves are in rack_drop.ngc / rack_pick.ngc. Both check the tool sensor
;   first, so the spindle never goes into the rack in the wrong state.
; - Valves via M64/M65; drawbar interlock (standstill, VFD comm) is in atc.hal.
; - Manual remove/load runs on the tool + drawbar sensors (5 s safety pause);
;   only the probe (PS_PROBE_TOOL) gets the confirmation prompt on the screen.

o<rack_change> sub
M73 ; auto-restore modal state on error; invalidated with M71 at the end
o<_psng_modal_save> call
o<_psng_hook> call [1]

; only in the milltask interpreter, otherwise preview breaks
o100 if [#<_task> EQ 0]
o100     return [999]
o100 endif

#<newtool>   = #<selected_tool>
#<oldtool>   = #<tool_in_spindle>
#<oldpocket> = #<old_home>
M66 E0
#<newpocket> = #5399
#<zs> = [#<_ini[AXIS_Z]MAX_LIMIT> - 1]
; the probe (cable!) is always changed with confirmation on the screen,
; every other manual change runs on the tool / drawbar sensors
#<probe> = #<_ini[VERSA_PROBE_OPTIONS]PS_PROBE_TOOL>

; after a restart LinuxCNC says T0 (interpreter even -1 = no tool) with a tool
; clamped. If the sensor sees a tool, take the last tool stored by
; python/last_tool.py (last_tool.txt).
; Sensor sees a tool but nothing is stored -> unknown tool -> stop.
o105 if [#<oldtool> LE 0]
    M66 P#<_ini[ATC_PINS]SENSOR_TOOL> L0
    o106 if [#5399 EQ 1]
        o107 if [#<stored_tool> GT 0]
            (DEBUG, %dNo tool set but the spindle holds one - using last tool T#<stored_tool> from the last session)
            M61 Q#<stored_tool>
            #<oldtool>   = #<stored_tool>
            #<oldpocket> = #<stored_home>
        o107 else
            (abort, Spindle holds a tool but the last tool is unknown - set it with M61 Q<tool>, then M6 again)
        o107 endif
    o106 endif
o105 endif
(print, M6: T#<oldtool> P#<oldpocket> -> T#<newtool> P#<newpocket>)

o110 if [[#<newtool> GT 0] AND [#<new_home> GE 0] AND [#<new_home> NE #<newpocket>]]
    (abort, Tool table pocket differs from prepared pocket - reload the tool table)
o110 endif

; LinuxCNC says a tool is loaded but the spindle sensor sees none (tool taken
; out by hand) -> ask (M192 Yes/No dialog). Yes = treat the spindle as empty
; and load the new tool normally (also when it is the same tool number).
; No = cancel the tool change.
o112 if [#<oldtool> GT 0]
    M66 P#<_ini[ATC_PINS]SENSOR_TOOL> L0
    o113 if [[#5399 NE 1] AND [#<newtool> LE 0]]
        ; M6 T0 (unload) and the spindle is already empty: just clear the tool
        (DEBUG, %dSpindle already empty - T#<oldtool> cleared)
        M61 Q0
        #<oldtool>   = 0
        #<oldpocket> = -1
    o113 elseif [#5399 NE 1]
        (DEBUG, %dNo tool detected in the spindle - LinuxCNC has T#<oldtool> loaded. Load T#<newtool>?)
        M192
        ; dialog open? (qtdragon.emptyspindle-waiting -> digital-in-06)
        M66 P6 L3 Q5
        o114 if [#5399 LT 0]
            (abort, No tool in the spindle but T#<oldtool> is loaded - dialog did not open. Set M61 Q0, then M6 again)
        o114 endif
        o115 do
            M66 P6 L4 Q60
        o115 while [#5399 LT 0]
        G4 P0.2 ; let the GUI set the response pin
        ; qtdragon.emptyspindle-response -> digital-in-05, 1 = Yes
        M66 P5 L0
        o116 if [#5399 NE 1]
            (abort, Tool change cancelled - spindle is empty, LinuxCNC still has T#<oldtool>)
        o116 endif
        ; spindle is empty: nothing to drop, pick/load the new tool
        M61 Q0
        #<oldtool>   = 0
        #<oldpocket> = -1
        (print, M6: spindle empty confirmed - loading T#<newtool> P#<newpocket>)
    o113 endif
o112 endif

; old and new tool share one rack pocket in the tool table: dropping the old tool
; would fill the pocket the new one should come from -> change both by hand.
; -1 = manual removal / manual load below, and slow search when measuring.
o120 if [[#<oldtool> GT 0] AND [#<newtool> GT 0] AND [#<oldtool> NE #<newtool>] AND [#<oldpocket> EQ #<newpocket>] AND [#<oldpocket> GE 1] AND [#<oldpocket> LE #<_ini[ATC]NUMPOCKETS>]]
    (DEBUG, %dT#<oldtool> and T#<newtool> share pocket P#<oldpocket> in the tool table - manual tool change for safety)
    #<oldpocket> = -1
    #<newpocket> = -1
o120 endif

G90 G40 G49
G53 G0 Z#<zs>

; spindle off and real standstill (< 0.5 Hz) before any tool handling
M5
M66 P#<_ini[ATC_PINS]SENSOR_SPINDLE_STOPPED> L3 Q#<_ini[ATC]SPINDLE_STOP_TIMEOUT>
o160 if [#5399 LT 0]
    (abort, Spindle did not stop in time - tool change aborted)
o160 endif

o150 if [#<oldtool> NE #<newtool>]
    ; ---------- 1. get rid of the old tool ----------
    o200 if [#<oldtool> GT 0]
        o210 if [[#<oldpocket> GE 1] AND [#<oldpocket> LE #<_ini[ATC]NUMPOCKETS>]]
            o<rack_drop> call [#<oldpocket>]
            ; spindle is empty now - keeps last_tool.txt right if the pick fails
            M61 Q0
        o210 else
            ; no rack pocket (P0, not in table, ...) -> remove manually
            G53 G0 X#<_ini[ATC]CHANGEX> Y#<_ini[ATC]CHANGEY>
            G53 G0 Z#<_ini[ATC]CHANGEZ>
            o215 if [#<oldtool> NE #<probe>]
                ; no screen confirmation: wait for tool out (sensor low), then
                ; drawbar closed again (button pressed a second time), then 5 s
                ; for the hands to get clear before the machine moves
                (DEBUG, %dRemove T#<oldtool> with the drawbar button and press it again to close - machine continues 5 s later)
                o216 do
                    M66 P#<_ini[ATC_PINS]SENSOR_TOOL> L4 Q60
                o216 while [#5399 LT 0]
                o217 do
                    M66 P#<_ini[ATC_PINS]SENSOR_DRAWBAR> L4 Q60
                o217 while [#5399 LT 0]
                G4 P5
                M66 P#<_ini[ATC_PINS]SENSOR_DRAWBAR> L0
                o218 if [#5399 EQ 1]
                    (abort, Drawbar opened again after manual removal - tool change aborted)
                o218 endif
                M61 Q0
            o215 else
                ; built-in M6 with T0 = operator prompt: remove tool with the drawbar button
                T0
                M6
                T#<newtool>
                M65 P#<_ini[ATC_PINS]ATC_OPEN>
                G4 P0.5
            o215 endif
            M66 P#<_ini[ATC_PINS]SENSOR_TOOL> L0
            o220 if [#5399 EQ 1]
                (abort, Tool still in spindle after manual removal - tool change aborted)
            o220 endif
            G53 G0 Z#<zs>
        o210 endif
    o200 endif

    ; ---------- 2. get the new tool ----------
    o300 if [#<newtool> GT 0]
        o310 if [[#<newpocket> GE 1] AND [#<newpocket> LE #<_ini[ATC]NUMPOCKETS>]]
            o<rack_pick> call [#<newpocket>]
            M61 Q#<newtool>
        o310 else
            G53 G0 Z#<zs>
            G53 G0 X#<_ini[ATC]CHANGEX> Y#<_ini[ATC]CHANGEY>
            G53 G0 Z#<_ini[ATC]CHANGEZ>
            o315 if [#<newtool> NE #<probe>]
                ; no screen confirmation: drawbar open (button), tool in, drawbar
                ; closed (button again) with a tool clamped, then 5 s for the hands
                ; to get clear. Closed without a tool -> wait for the next try.
                (DEBUG, %dInsert T#<newtool> with the drawbar button and press it again to close - machine continues 5 s later)
                o316 do
                    o317 do
                        M66 P#<_ini[ATC_PINS]SENSOR_DRAWBAR> L3 Q60
                    o317 while [#5399 LT 0]
                    o318 do
                        M66 P#<_ini[ATC_PINS]SENSOR_DRAWBAR> L4 Q60
                    o318 while [#5399 LT 0]
                    G4 P0.5
                    M66 P#<_ini[ATC_PINS]SENSOR_TOOL> L0
                o316 while [#5399 NE 1]
                G4 P5
                M66 P#<_ini[ATC_PINS]SENSOR_DRAWBAR> L0
                o319 if [#5399 EQ 1]
                    M72
                    (abort, Drawbar opened again after manual tool load - tool change aborted)
                o319 endif
            o315 else
                ; built-in M6 = operator prompt to insert the tool
                M6
            o315 endif
            ; air on the clamp side for 3 s
            M64 P#<_ini[ATC_PINS]ATC_CLOSE>
            G4 P3
            M65 P#<_ini[ATC_PINS]ATC_CLOSE>
            M66 P#<_ini[ATC_PINS]SENSOR_DRAWBAR> L4 Q#<_ini[ATC]DRAWBAR_TIMEOUT>
            o320 if [#5399 NE 0]
                M72
                (abort, Drawbar is still open after manual tool load - press the drawbar button to close it)
            o320 endif
            M66 P#<_ini[ATC_PINS]SENSOR_TOOL> L0
            o330 if [#5399 NE 1]
                M72
                (abort, No tool clamped after manual tool load - tool change aborted)
            o330 endif
            ; sensor path has no built-in M6 that sets the tool
            M61 Q#<newtool>
        o310 endif
    o300 endif

    ; ---------- 3. measure (probe screen button) or use table length ----------
    ; a tool without a length is always measured, even with the probe screen button off:
    ; G43 with length 0 would put the real tool tip far below where LinuxCNC thinks it is
    #<measure> = #<_hal[qtversaprobe.enable]>
    o404 if [#<newtool> EQ #<probe>]
        ; the probe is never measured on the tool setter, its length is set by hand
        #<measure> = 0
        o403 if [#<new_has_length> EQ 0]
            M72
            (abort, Probe T#<probe> has no length in the tool table - enter it, the probe is not measured on the setter)
        o403 endif
    o404 elseif [[#<newtool> GT 0] AND [#<new_has_length> EQ 0]]
        (DEBUG, T#<newtool> has no length in the tool table - measuring with the slow search from the top)
        #<measure> = 1
    o404 endif
    o400 if [#<measure> EQ 1]
        ; fast approach only for a rack tool with a length and a recorded touch
        #<fast_z> = 0
        o415 if [[#<_ini[TOOLSENSOR]FAST_APPROACH> GT 0] AND [#<new_touch_ok> EQ 1] AND [#<newpocket> GE 1] AND [#<newpocket> LE #<_ini[ATC]NUMPOCKETS>]]
            #<fast_z> = [#<new_touch> + #<_ini[TOOLSENSOR]FAST_APPROACH>]
        o415 endif
        o<tool_measure> call [#<newtool>] [#<fast_z>]
        #<result> = #<_value>
        o440 if [#<result> LT -2]
            M72
        o440 endif
        o445 if [#<result> LT 0]
            o445 return [#<result>]
        o445 endif
        G43
    o400 else
        G43 H#<newtool>
    o400 endif

o150 else
    ; same tool - nothing to do
    M72
o150 endif

M71 ; tool change done - invalidate modal auto-restore
o<_psng_modal_restore> call
o<rack_change> endsub [1]

M2
%
