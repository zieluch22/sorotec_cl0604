; Setup mode, one edge point. Positions are machine X/Y; heights are in the active offset.
; #1 #2 descent point, #3 #4 end of search, #5 safe Z, #6 check Z, #7 travel feed, #8 probe feed
; #9 digital output that selects the probe input (-1 = none)
o<setup_touch> sub
G21 G90
o120 if [#9 GE 0]
    M64 P#9
o120 endif
#<ox> = #[5201 + 20 * #5220]
#<oy> = #[5202 + 20 * #5220]
#<sx> = [#1 - #<ox>]
#<sy> = [#2 - #<oy>]
o<setup_pmove> call [#<sx>] [#<sy>] [#5] [#7]
o<setup_pmove> call [#<sx>] [#<sy>] [#6] [#7]
G38.2 X[#3 - #<ox>] Y[#4 - #<oy>] F#8
#<mx> = [#5061 + #<ox>]
#<my> = [#5062 + #<oy>]
G1 X#<sx> Y#<sy> F#7
G1 Z#5 F#7
(LOGAPPEND,/tmp/table_nav_probe.log)
(LOG,T #<mx> #<my>)
(LOGCLOSE)
o<setup_touch> endsub
M2
